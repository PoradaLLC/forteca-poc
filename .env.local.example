# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to Git

# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...
SUPABASE_SECRET_KEY=eyJ...             # Server-side only — never expose to client

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@fortecaestate.com

# ─── Image Hosting (Cloudinary) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=forteca
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# ─── Auth (NextAuth) ───────────────────────────────────────────────────────────
AUTH_SECRET=...                        # openssl rand -base64 32
AUTH_URL=https://fortecaestate.com

# ─── Rate Limiting (Upstash Redis) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ─── Cron (iCal sync) ─────────────────────────────────────────────────────────
CRON_SECRET=...                        # openssl rand -base64 32 — authorizes /api/ical/sync

# ─── Meta Pixel / Conversions API ─────────────────────────────────────────────
META_PIXEL_ID=1325589082840284
META_PIXEL_ACCESS_TOKEN=...            # Events Manager → Settings → Conversions API → Generate access token
META_TEST_EVENT_CODE=                  # Optional — paste from Events Manager → Test Events tab while testing, then remove
